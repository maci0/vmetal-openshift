frr defaults traditional
hostname vmetal-frr
!
{# Host-side BGP router for MetalLB BGP mode. eBGP, dynamic neighbours over the
   machine subnet (so nodes are not enumerated), no policy required so the LB
   /32s are accepted. zebra installs them into the host kernel -> the host can
   reach the off-link LB pool, and ECMP load-balances across the speakers. #}
router bgp {{ cluster.metallb_bgp_router_asn }}
  bgp router-id {{ cluster.machine_gateway }}
  no bgp ebgp-requires-policy
  bgp listen range {{ cluster.machine_cidr }} peer-group ocp
  neighbor ocp peer-group
  neighbor ocp remote-as {{ cluster.metallb_bgp_node_asn }}
  address-family ipv4 unicast
    neighbor ocp activate
    maximum-paths 8
  exit-address-family
!
