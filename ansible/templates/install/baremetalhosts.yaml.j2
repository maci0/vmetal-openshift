{#
  BareMetalHost CRs so the installed cluster manages these nodes via the BMC
  (power on/off, reboot, MachineHealthCheck, scaling). Apply after install:
    oc apply -f clusters/<name>/baremetalhosts.yaml
  For agent-based installs this is the Day-2 hook that wires the cluster to the
  Redfish BMC; for IPI the same data already lives in install-config.
#}
{% for node in cluster.nodes if node.role != 'bootstrap' %}
---
apiVersion: v1
kind: Secret
metadata:
  name: {{ node.fullname }}-bmc-secret
  namespace: openshift-machine-api
type: Opaque
stringData:
  username: {{ cluster.bmc_user }}
  password: {{ cluster.bmc_pass }}
---
apiVersion: metal3.io/v1alpha1
kind: BareMetalHost
metadata:
  name: {{ node.fullname }}
  namespace: openshift-machine-api
spec:
  online: true
{#  Day-2 BMHs are for power management of already-installed nodes (agent + upi).
    Always mark externallyProvisioned so metal3 never tries to reimage them.
    Green-field BMH enrollment is not what these manifests are for. #}
  externallyProvisioned: true
  bootMACAddress: {{ node.mac }}
  bmc:
    address: {{ node.bmc_address }}
    credentialsName: {{ node.fullname }}-bmc-secret
    disableCertificateVerification: true
  rootDeviceHints:
    deviceName: /dev/{{ node.disks[0].target }}
{% endfor %}
