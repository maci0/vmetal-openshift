{# HyperConverged deploys KubeVirt + CDI + the storage/network components. Live
   migration is pinned to the dedicated migration VLAN (bond1.40) via the
   `migration` NAD, when that network is enabled (cnv_migration_network). #}
---
apiVersion: hco.kubevirt.io/v1beta1
kind: HyperConverged
metadata:
  name: kubevirt-hyperconverged
  namespace: openshift-cnv
spec:
  liveMigrationConfig:
    parallelMigrationsPerCluster: 5
    parallelOutboundMigrationsPerNode: 2
{% if cnv_migration_network | default(true) and cluster.migration_iface is defined %}
    network: migration
{% endif %}
