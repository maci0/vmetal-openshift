{# OpenShift Virtualization (CNV): the kubevirt-hyperconverged operator. Day-2;
   needs nested virt on the host + /dev/kvm in the guests (this lab provides both
   via host-passthrough CPUs). Apply after the cluster is up. #}
---
apiVersion: v1
kind: Namespace
metadata:
  name: openshift-cnv
---
apiVersion: operators.coreos.com/v1
kind: OperatorGroup
metadata:
  name: kubevirt-hyperconverged-group
  namespace: openshift-cnv
spec:
  targetNamespaces:
    - openshift-cnv
---
apiVersion: operators.coreos.com/v1alpha1
kind: Subscription
metadata:
  name: hco-operatorhub
  namespace: openshift-cnv
spec:
  source: {{ 'vmetal-operators' if (cluster.disconnected | default(disconnected)) else 'redhat-operators' }}
  sourceNamespace: openshift-marketplace
  name: kubevirt-hyperconverged
{% if cnv_channel | default('') %}
  channel: {{ cnv_channel }}
{% endif %}
  installPlanApproval: Automatic
