{% set ps = lookup('file', pull_secret_file, errors='ignore') %}
{% set sk = lookup('file', ssh_key_file, errors='ignore') %}
apiVersion: v1
baseDomain: {{ cluster.base_domain }}
metadata:
  name: {{ cluster.name }}
controlPlane:
  name: master
  replicas: {{ cluster.control_plane_replicas }}
  architecture: amd64
  hyperthreading: Enabled
compute:
- name: worker
  replicas: {{ cluster.worker_replicas }}
  architecture: amd64
  hyperthreading: Enabled
networking:
  networkType: OVNKubernetes
  clusterNetwork:
  - cidr: 10.128.0.0/14
    hostPrefix: 23
  serviceNetwork:
  - 172.30.0.0/16
  machineNetwork:
  - cidr: {{ cluster.machine_cidr }}
platform:
{% if cluster.sno or cluster.mode == 'upi' %}
{#   upi is always platform: none (user-provided LB/DNS); so is single-node agent #}
  none: {}
{% else %}
  baremetal:
    apiVIPs:
    - {{ cluster.api_vip }}
    ingressVIPs:
    - {{ cluster.ingress_vip }}
{% endif %}
{% if cluster.mode == 'upi' and cluster.sno %}
{#   Single-node UPI is bootstrap-in-place: the live ISO installs RHCOS to the
     node's first disk (sda for scsi, vda for virtio). Override with upi_install_disk.
     Multi-node UPI uses a real bootstrap node, so no bootstrapInPlace. #}
bootstrapInPlace:
  installationDisk: {{ cluster.upi_install_disk | default('/dev/' ~ cluster.nodes[0].disks[0].target) }}
{% endif %}
{% if cluster.disconnected | default(false) %}
{% set mirror_ca = lookup('file', playbook_dir + '/../../' + (mirror_ca_file | default('certs/mirror/ca.pem')), errors='ignore') %}
imageDigestSources:
- mirrors:
  - {{ cluster.mirror_registry }}/openshift/release
  source: quay.io/openshift-release-dev/ocp-v4.0-art-dev
- mirrors:
  - {{ cluster.mirror_registry }}/openshift/release
  source: quay.io/openshift-release-dev/ocp-release
additionalTrustBundle: |
{{ (mirror_ca if mirror_ca else "  REPLACE_WITH_MIRROR_REGISTRY_CA_PEM (run make mirror)") | indent(2, True) }}
{% endif %}
pullSecret: '{{ (ps | from_json | to_json) if ps else "REPLACE_WITH_PULL_SECRET_JSON" }}'
{% if sk %}
sshKey: '{{ sk | trim }}'
{% endif %}
