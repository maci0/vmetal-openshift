{# LVMCluster: build a thin-provisioned volume group on each worker's dedicated
   dedicated empty disks and expose it as the default RWO StorageClass (lvms-vg1).
   Local storage, so volumes are node-bound (no live migration). #}
---
apiVersion: lvm.topolvm.io/v1alpha1
kind: LVMCluster
metadata:
  name: lvmcluster
  namespace: openshift-storage
spec:
  storage:
    deviceClasses:
      - name: vg1
        default: true
        fstype: xfs
{% if lvms_device | default('') %}
        {# explicit disk path. NOTE: with virtio-scsi the guest enumerates disks
           async, so /dev/sdX is not a stable mapping to a specific qcow2; prefer
           leaving lvms_device empty so LVMS auto-uses all unused disks. #}
        deviceSelector:
          paths:
            - {{ lvms_device }}
{% endif %}
        thinPoolConfig:
          name: thin-pool-1
          sizePercent: 90
          overprovisionRatio: 10
        nodeSelector:
          nodeSelectorTerms:
            - matchExpressions:
                - key: node-role.kubernetes.io/worker
                  operator: Exists
