{# MetalLB instance + an L2 address pool on the machine net (.100-.119, clear of
   nodes, VIPs, and the DHCP range). Layer2 mode needs no BGP/switch config.
   Apply after the operator is installed (its CRDs must exist first). #}
---
apiVersion: metallb.io/v1beta1
kind: MetalLB
metadata:
  name: metallb
  namespace: metallb-system
---
apiVersion: metallb.io/v1beta1
kind: IPAddressPool
metadata:
  name: {{ cluster.name }}-pool
  namespace: metallb-system
spec:
  addresses:
    - {{ cluster.metallb_pool }}
---
apiVersion: metallb.io/v1beta1
kind: L2Advertisement
metadata:
  name: {{ cluster.name }}-l2
  namespace: metallb-system
spec:
  ipAddressPools:
    - {{ cluster.name }}-pool
