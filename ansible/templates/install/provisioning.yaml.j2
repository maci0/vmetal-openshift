{#
  metal3 Provisioning CR. Creating this on a platform: baremetal cluster tells
  the cluster-baremetal-operator to deploy metal3/ironic, which then reconciles
  BareMetalHost objects. Virtual-media mode (no provisioning network), matching
  the emulated Redfish BMC. Not used on platform: none (single-node) clusters,
  where the operator stays dormant.
#}
apiVersion: metal3.io/v1alpha1
kind: Provisioning
metadata:
  name: provisioning-configuration
spec:
  provisioningNetwork: Disabled
  watchAllNamespaces: true
  virtualMediaViaExternalNetwork: true
