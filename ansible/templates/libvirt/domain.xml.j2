<domain type="kvm">
  <name>{{ node.fullname }}</name>
  <uuid>{{ node.uuid }}</uuid>
  <memory unit="MiB">{{ node.memory_mib }}</memory>
  <vcpu placement="static">{{ node.vcpus }}</vcpu>
  <os>
    <type arch="x86_64" machine="q35">hvm</type>
    <loader readonly="yes" type="pflash">{{ ovmf_code }}</loader>
    <nvram template="{{ ovmf_vars }}"/>
    <bios useserial="yes"/>
  </os>
  <features>
    <acpi/>
    <apic/>
    <smm state="on"/>
  </features>
  <cpu mode="host-passthrough" check="none"/>
  <devices>
{# Per-device boot order: disk first (order 1), cdrom second (order 2). On an
   empty disk (first boot) the firmware falls through to the ISO; once the image
   is written, reboots boot the disk. This avoids a fragile one-time-boot and the
   "booted the installation image again" stall after install. #}
{% set dbus = disk_bus | default('scsi') %}
{% if dbus == 'scsi' %}
    {# one virtio-scsi controller carries all disks (so many fit one PCIe slot) and
       lets each disk advertise rotation_rate (SSD). #}
    <controller type="scsi" index="0" model="virtio-scsi"/>
{% endif %}
{% for d in node.disks %}
    <disk type="file" device="disk">
      {# cache=none + io=native: direct I/O, no host page cache (host cache would
         compete with the VM RAM/zram we work to free). discard/detect_zeroes keep
         the thin qcow2 small. #}
      <driver name="qemu" type="qcow2" cache="{{ disk_cache | default('none') }}" io="{{ disk_io | default('native') }}" discard="unmap" detect_zeroes="unmap"/>
      <source file="{{ images_dir }}/{{ node.fullname }}-{{ d.suffix }}.qcow2"/>
{% if dbus in ['scsi', 'sata'] %}
      <target dev="{{ d.target }}" bus="{{ dbus }}" rotation_rate="{{ disk_rotation_rate | default(1) }}"/>
{% else %}
      <target dev="{{ d.target }}" bus="{{ dbus }}"/>
{% endif %}
{% if loop.first %}
      <boot order="1"/>
{% endif %}
    </disk>
{% endfor %}
{% if cluster.static_iso %}
    {# agent + boot_via=iso: attach the discovery ISO directly (boot with
       `virsh start`, no BMC needed). Otherwise the drive is empty and sushy/
       metal3 inserts the image over Redfish virtual media. #}
    <disk type="file" device="cdrom">
      <driver name="qemu" type="raw"/>
      <source file="{{ cluster.discovery_iso }}"/>
      <target dev="sdz" bus="sata"/>
      <readonly/>
      <boot order="2"/>
    </disk>
{% else %}
    <!-- empty drive; sushy/metal3 inserts the image via Redfish virtual media -->
    <disk type="file" device="cdrom">
      <driver name="qemu" type="raw"/>
      <target dev="sdz" bus="sata"/>
      <readonly/>
      <boot order="2"/>
    </disk>
{% endif %}
{% for nic in node.interfaces %}
    <!-- {{ nic.bond }} slave ({{ nic.devname }}) -> {{ nic.attach }} -->
    <interface type="network">
      <source network="{{ nic.attach }}"/>
      <mac address="{{ nic.mac }}"/>
      <model type="virtio"/>
{% if nic.mtu is defined %}
      <mtu size="{{ nic.mtu }}"/>
{% endif %}
    </interface>
{% endfor %}
    <serial type="pty">
      <target port="0"/>
    </serial>
    <console type="pty">
      <target type="serial" port="0"/>
    </console>
    <graphics type="vnc" port="-1" autoport="yes"/>
  </devices>
</domain>
