{# NFS-Ganesha export for the host "storage appliance" (scripts/nfs.sh runs it as
   a container). NFSv4 only, so a single port (2049) is enough, no rpcbind/mountd.
   Exports /export (a disk-backed host dir bind-mounted into the container). #}
NFS_CORE_PARAM {
    Protocols = 4;
    Enable_NLM = false;
    Enable_RQUOTA = false;
}

EXPORT {
    Export_Id = 1;
    Path = /export;
    Pseudo = /export;
    Access_Type = RW;
    Squash = No_Root_Squash;
    Transports = TCP;
    SecType = sys;
    FSAL {
        Name = VFS;
    }
}

LOG {
    Default_Log_Level = WARN;
}
