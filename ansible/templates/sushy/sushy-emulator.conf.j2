# sushy-emulator configuration (generated by ansible/lifecycle/sushy.yml).
# Redfish BMC emulator backed by libvirt. Do not edit by hand.

SUSHY_EMULATOR_LIBVIRT_URI = u"{{ libvirt_uri }}"

# Honour the boot device the client (installer/metal3) sets.
SUSHY_EMULATOR_IGNORE_BOOT_DEVICE = False

# UEFI boot loader so emulated systems match the OVMF firmware the VMs use.
SUSHY_EMULATOR_BOOT_LOADER_MAP = {
    u'UEFI': {
        u'x86_64': u'{{ ovmf_code }}',
        u'aarch64': None,
    },
    u'Legacy': {
        u'x86_64': None,
        u'aarch64': None,
    },
}

# Lab uses self-signed / plain HTTP image URLs for virtual media.
SUSHY_EMULATOR_VMEDIA_VERIFY_SSL = False
