[Unit]
Description=sushy-emulator (Redfish BMC for libvirt)
# This is a `systemctl --user` unit; it cannot order against system units
# (libvirtd/network-online), so Restart=on-failure covers a not-yet-ready libvirt.

[Service]
ExecStart={{ venv_bin }}/sushy-emulator \
  --config {{ sushy_conf }} \
  --ssl-certificate {{ tls_cert }} \
  --ssl-key {{ tls_key }} \
  -i 0.0.0.0 -p {{ sushy_port }}
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
