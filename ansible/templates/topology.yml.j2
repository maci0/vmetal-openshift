{#
  Derive the full lab topology from the addressing scheme, `networks`, and
  `nic_layout`. Rendered to YAML and parsed into the `topology` fact.

  networks: map name -> {cidr, kind, dns, mtu}. kind nat/isolated/l2 become
    libvirt networks; kind vlan are tagged subinterfaces on a trunk bond.
  nic_layout: bonds. A bond attaches untagged to one `network`, or to a `trunk`
    carrier with tagged `vlans`. NIC device names are eth0..N in nic_layout order.

  MAC: <oui>:<cluster-index>:<bond*16 + nic>:<node-octet>. Node IPs (machine +
  each vlan) are static; the machine net also has DHCP reservations for them.
#}
{% for c in clusters %}
{%   set ci = c.subnet_index | default(loop.index0) %}
{%   set domain = c.name ~ '.' ~ (c.base_domain | default(base_domain)) %}
{#   Topology is explicit: control_plane and workers per cluster. control_plane
     defaults to control_plane_count_default; workers defaults to 0. #}
{%   set cp = (c.control_plane | default(control_plane_count_default)) | int %}
{%   set workers = (c.workers | default(0)) | int %}
{%   set ncount = cp + workers %}
{%   set day2_count = c.day2_workers | default(0) | int %}
{%   set sched = c.masters_schedulable | default(masters_schedulable) | string %}
{%   set masters_sched = true if sched == 'True' or sched == 'true' else (false if sched == 'False' or sched == 'false' else (workers == 0)) %}
{%   set machine_cidr = networks.machine.cidr | replace('{c}', ci | string) %}
{%   set mp3 = machine_cidr.split('/')[0].rsplit('.', 1)[0] %}
{%   set api_o = c.api_vip_offset | default(api_vip_offset) | int %}
{%   set ing_o = c.ingress_vip_offset | default(ingress_vip_offset) | int %}
{%   set mode = c.install_mode | default(install_mode) %}
{%   set boot = c.boot_via | default(boot_via) %}
{#   VIP/LB target: SNO collapses onto the node IP; multi-node baremetal uses the
     keepalived VIPs; multi-node upi (platform: none) points api/ingress DNS at the
     host HAProxy on the machine gateway (.1). #}
{%   set api_vip = (mp3 ~ '.' ~ node_ip_offset) if ncount == 1 else ((mp3 ~ '.1') if mode == 'upi' else (mp3 ~ '.' ~ api_o)) %}
{%   set ingress_vip = (mp3 ~ '.' ~ node_ip_offset) if ncount == 1 else ((mp3 ~ '.1') if mode == 'upi' else (mp3 ~ '.' ~ ing_o)) %}
{%   set static_iso = (mode == 'agent') and (boot == 'iso') %}
{#   upi can netboot (boot_via: pxe): the machine net dnsmasq chainloads ipxe.efi
     over tftp, then serves an iPXE script over http that boots RHCOS live. #}
{%   set pxe = (mode == 'upi') and (boot == 'pxe') %}
{%   set disc = c.disconnected | default(disconnected) %}
{%   set oob_cidr = (networks.oob.cidr | replace('{c}', ci | string)) if networks.oob is defined else '' %}
{#   BMC host: the oob LAN gateway normally. For upi the in-cluster metal3/ironic
     must reach the BMC, and cluster nodes have no route to the host-only oob net,
     so upi points the BMC at the machine gateway (sushy binds 0.0.0.0). #}
{%   set bmc_host = (mp3 ~ '.1') if mode == 'upi' else ((oob_cidr.split('/')[0].rsplit('.', 1)[0] ~ '.1') if oob_cidr else (mp3 ~ '.1')) %}
{#   provisioning interface for IPI Managed: the vlan/bond carrying it #}
{%   set pn = namespace(dev='') %}
{%   for b in nic_layout %}
{%     if b.network | default('') == 'provisioning' %}{% set pn.dev = b.bond %}{% endif %}
{%     for v in b.vlans | default([]) %}{% if v.network == 'provisioning' %}{% set pn.dev = b.bond ~ '.' ~ v.id %}{% endif %}{% endfor %}
{%   endfor %}
{%   set prov_cidr = (networks.provisioning.cidr | replace('{c}', ci | string)) if networks.provisioning is defined else '' %}
{%   set prov_p3 = prov_cidr.split('/')[0].rsplit('.', 1)[0] if prov_cidr else '' %}
{#   migration interface (vlan/bond carrying the live-migration net) for CNV #}
{%   set mg = namespace(dev='') %}
{%   for b in nic_layout %}
{%     for v in b.vlans | default([]) %}{% if v.network == 'migration' %}{% set mg.dev = b.bond ~ '.' ~ v.id %}{% endif %}{% endfor %}
{%   endfor %}
{%   set mig_cidr = (networks.migration.cidr | replace('{c}', ci | string)) if networks.migration is defined else '' %}
{%   set mig_p3 = mig_cidr.split('/')[0].rsplit('.', 1)[0] if mig_cidr else '' %}
- name: {{ c.name }}
  fqdn: {{ domain }}
  base_domain: {{ c.base_domain | default(base_domain) }}
  sno: {{ ncount == 1 }}
  mode: {{ mode }}
  static_iso: {{ static_iso }}
  pxe: {{ pxe }}
  disconnected: {{ disc }}
  mirror_registry: {{ mp3 }}.1:{{ mirror_registry_port | default(5000) }}
  api_vip: {{ api_vip }}
  ingress_vip: {{ ingress_vip }}
  control_plane_replicas: {{ cp }}
  worker_replicas: {{ workers }}
  masters_schedulable: {{ masters_sched }}
  metallb_pool: {{ mp3 }}.100-{{ mp3 }}.119
  metallb_bgp_pool: 198.51.{{ 100 + ci }}.0/24
  metallb_bgp_node_asn: {{ metallb_bgp_node_asn }}
  metallb_bgp_router_asn: {{ metallb_bgp_router_asn }}
{%   if mig_cidr %}
  migration_iface: {{ mg.dev }}
  migration_cidr: {{ mig_cidr }}
  migration_mtu: {{ networks.migration.mtu | default(1500) }}
  migration_range_start: {{ mig_p3 }}.100
  migration_range_end: {{ mig_p3 }}.200
{%   endif %}
  machine_net: {{ c.name }}-machine
  machine_cidr: {{ machine_cidr }}
  machine_gateway: {{ mp3 }}.1
  rendezvous_ip: {{ mp3 }}.{{ node_ip_offset }}
  discovery_iso: {{ playbook_dir }}/../build/discovery_image_{{ c.name }}.iso
  bmc_host: {{ bmc_host }}
  bmc_user: {{ bmc_username }}
  bmc_pass: {{ bmc_password }}
{%   if prov_cidr %}
  provisioning_mode: {{ c.provisioning_network_mode | default(provisioning_network_mode) }}
  provisioning_cidr: {{ prov_cidr }}
{#   metal3's PXE/inspection DHCP pool; kept above the static node provisioning
     IPs (.10+) so it never hands out an address a node statically owns. #}
  provisioning_dhcp_start: {{ prov_p3 }}.150
  provisioning_dhcp_end: {{ prov_p3 }}.250
  cluster_provisioning_ip: {{ prov_p3 }}.2
  bootstrap_provisioning_ip: {{ prov_p3 }}.3
  prov_interface: {{ pn.dev }}
{%   endif %}
  networks:
{%   for nname, n in networks.items() %}
{%     if n.kind in ['nat', 'isolated', 'l2'] %}
{%       set p3 = (n.cidr | replace('{c}', ci | string)).split('/')[0].rsplit('.', 1)[0] if n.cidr is defined else '' %}
    - name: {{ c.name }}-{{ nname }}
      role: {{ nname }}
      kind: {{ n.kind }}
      bridge: br{{ ci }}{{ nname[0] }}
      forward: {{ 'nat' if n.kind == 'nat' else 'none' }}
{%       if n.mtu is defined %}
      mtu: {{ n.mtu }}
{%       endif %}
{%       if n.cidr is defined %}
      gateway: {{ p3 }}.1
      netmask: 255.255.255.0
      dhcp_start: {{ p3 }}.{{ dhcp_pool_start }}
      dhcp_end: {{ p3 }}.{{ dhcp_pool_end }}
{%       endif %}
{%       if n.dns | default(false) %}
      domain: {{ domain }}
{%         if pxe %}
      pxe: true
{%         endif %}
      dns_options:
        - "address=/.apps.{{ domain }}/{{ ingress_vip }}"
        - "address=/api.{{ domain }}/{{ api_vip }}"
        - "address=/api-int.{{ domain }}/{{ api_vip }}"
{%         if pxe %}
        - "dhcp-match=set:ipxe,175"
        - "dhcp-boot=tag:!ipxe,ipxe.efi"
        - "dhcp-boot=tag:ipxe,http://{{ p3 }}.1:{{ pxe_http_port | default(8099) }}/boot.ipxe"
{%         endif %}
      reservations:
{%         if mode == 'upi' and ncount > 1 %}
        - name: {{ c.name }}-bootstrap
          mac: "{{ mac_oui }}:{{ '%02x' | format(ci) }}:00:{{ '%02x' | format(node_ip_offset - 1) }}"
          ip: {{ p3 }}.{{ node_ip_offset - 1 }}
{%         endif %}
{%         for nidx in range(ncount) %}
        - name: {{ c.name }}-node{{ nidx }}
          mac: "{{ mac_oui }}:{{ '%02x' | format(ci) }}:00:{{ '%02x' | format(node_ip_offset + nidx) }}"
          ip: {{ p3 }}.{{ node_ip_offset + nidx }}
{%         endfor %}
{%         for widx in range(day2_count) %}
        - name: {{ c.name }}-day2-worker{{ widx }}
          mac: "{{ mac_oui }}:{{ '%02x' | format(ci) }}:00:{{ '%02x' | format(node_ip_offset + ncount + widx) }}"
          ip: {{ p3 }}.{{ node_ip_offset + ncount + widx }}
{%         endfor %}
{%       endif %}
{%     endif %}
{%   endfor %}
  nodes:
{%   for nidx in range(ncount) %}
{%     set node_o = node_ip_offset + nidx %}
{%     set ns = namespace(i=0) %}
{%     set role = 'master' if nidx < cp else 'worker' %}
{%     set node_mem = (c.master_memory_mib if role == 'master' else c.worker_memory_mib) | default(c.memory_mib | default(default_memory_mib)) %}
{%     set node_cpu = (c.master_vcpus if role == 'master' else c.worker_vcpus) | default(c.vcpus | default(default_vcpus)) %}
    - name: node{{ nidx }}
      fullname: {{ c.name }}-node{{ nidx }}
      role: {{ role }}
      ip: {{ mp3 }}.{{ node_o }}
      mac: "{{ mac_oui }}:{{ '%02x' | format(ci) }}:00:{{ '%02x' | format(node_o) }}"
      uuid: {{ '%08x' | format(ci) }}-0000-4000-8000-{{ '%012x' | format(node_o) }}
      bmc_address: "redfish-virtualmedia://{{ bmc_host }}:{{ sushy_port }}/redfish/v1/Systems/{{ '%08x' | format(ci) }}-0000-4000-8000-{{ '%012x' | format(node_o) }}"
      memory_mib: {{ node_mem }}
      vcpus: {{ node_cpu }}
{%     set node_disks = worker_disks if (role == 'worker' and worker_disks is defined) else (c.disks | default(default_disks)) %}
{#     A bond attaches to this node if it has no role restriction, or the node's
       role is listed, or it is a schedulable control-plane node (runs workloads)
       and the bond is for workers. Non-schedulable masters skip the data-plane
       (storage/migration) card. #}
      addresses:
{%     for b in nic_layout %}
{%       set has = (b.roles is not defined) or (role in (b.roles | default([]))) or (role == 'master' and masters_sched and 'worker' in (b.roles | default([]))) %}
{%       if has %}
{%         if b.network is defined and networks[b.network].cidr is defined %}
        {{ b.network }}: {{ (networks[b.network].cidr | replace('{c}', ci | string)).split('/')[0].rsplit('.', 1)[0] }}.{{ node_o }}
{%         endif %}
{%         for v in b.vlans | default([]) %}
{%           if networks[v.network].cidr is defined %}
        {{ v.network }}: {{ (networks[v.network].cidr | replace('{c}', ci | string)).split('/')[0].rsplit('.', 1)[0] }}.{{ node_o }}
{%           endif %}
{%         endfor %}
{%       endif %}
{%     endfor %}
      interfaces:
{%     for b in nic_layout %}
{%       set bidx = loop.index0 %}
{%       set has = (b.roles is not defined) or (role in (b.roles | default([]))) or (role == 'master' and masters_sched and 'worker' in (b.roles | default([]))) %}
{%       if has %}
{%         set attach = b.network | default(b.trunk) %}
{%         for k in range(b.nics) %}
        - devname: eth{{ ns.i }}
          bond: {{ b.bond }}
          attach: {{ c.name }}-{{ attach }}
          mac: "{{ mac_oui }}:{{ '%02x' | format(ci) }}:{{ '%02x' | format(bidx * 16 + k) }}:{{ '%02x' | format(node_o) }}"
{%         if networks[attach].mtu is defined %}
          mtu: {{ networks[attach].mtu }}
{%         endif %}
{%         set ns.i = ns.i + 1 %}
{%         endfor %}
{%       endif %}
{%     endfor %}
      disks:
{%     for d in node_disks %}
        - { suffix: {{ d.suffix }}, capacity_gib: {{ d.capacity_gib }}, target: {{ d.target }} }
{%     endfor %}
{%   endfor %}
{#   Multi-node upi needs a transient bootstrap node (removed after
     bootstrap-complete). It only needs the machine net; it boots the live env in
     RAM and never installs to disk. #}
{%   if mode == 'upi' and ncount > 1 %}
{%     set bo = node_ip_offset - 1 %}
    - name: bootstrap
      fullname: {{ c.name }}-bootstrap
      role: bootstrap
      ip: {{ mp3 }}.{{ bo }}
      mac: "{{ mac_oui }}:{{ '%02x' | format(ci) }}:00:{{ '%02x' | format(bo) }}"
      uuid: {{ '%08x' | format(ci) }}-0000-4000-8000-{{ '%012x' | format(bo) }}
      bmc_address: "redfish-virtualmedia://{{ bmc_host }}:{{ sushy_port }}/redfish/v1/Systems/{{ '%08x' | format(ci) }}-0000-4000-8000-{{ '%012x' | format(bo) }}"
      memory_mib: {{ c.master_memory_mib | default(c.memory_mib | default(default_memory_mib)) }}
      vcpus: {{ c.master_vcpus | default(c.vcpus | default(default_vcpus)) }}
      addresses:
        machine: {{ mp3 }}.{{ bo }}
      interfaces:
        - devname: eth0
          bond: {{ nic_layout[0].bond }}
          attach: {{ c.name }}-machine
          mac: "{{ mac_oui }}:{{ '%02x' | format(ci) }}:00:{{ '%02x' | format(bo) }}"
      disks:
{%     for d in default_disks %}
        - { suffix: {{ d.suffix }}, capacity_gib: {{ d.capacity_gib }}, target: {{ d.target }} }
{%     endfor %}
{%   endif %}
  day2_workers:{{ ' []' if day2_count == 0 else '' }}
{%   for widx in range(day2_count) %}
{%     set node_o = node_ip_offset + ncount + widx %}
{%     set ns = namespace(i=0) %}
    - name: day2-worker{{ widx }}
      fullname: {{ c.name }}-day2-worker{{ widx }}
      role: worker
      ip: {{ mp3 }}.{{ node_o }}
      mac: "{{ mac_oui }}:{{ '%02x' | format(ci) }}:00:{{ '%02x' | format(node_o) }}"
      uuid: {{ '%08x' | format(ci) }}-0000-4000-8000-{{ '%012x' | format(node_o) }}
      bmc_address: "redfish-virtualmedia://{{ bmc_host }}:{{ sushy_port }}/redfish/v1/Systems/{{ '%08x' | format(ci) }}-0000-4000-8000-{{ '%012x' | format(node_o) }}"
      memory_mib: {{ c.worker_memory_mib | default(c.memory_mib | default(default_memory_mib)) }}
      vcpus: {{ c.worker_vcpus | default(c.vcpus | default(default_vcpus)) }}
{#     day-2 nodes are always workers; same role-aware bond filter as above. #}
      addresses:
{%     for b in nic_layout %}
{%       set has = (b.roles is not defined) or ('worker' in (b.roles | default([]))) %}
{%       if has %}
{%         if b.network is defined and networks[b.network].cidr is defined %}
        {{ b.network }}: {{ (networks[b.network].cidr | replace('{c}', ci | string)).split('/')[0].rsplit('.', 1)[0] }}.{{ node_o }}
{%         endif %}
{%         for v in b.vlans | default([]) %}
{%           if networks[v.network].cidr is defined %}
        {{ v.network }}: {{ (networks[v.network].cidr | replace('{c}', ci | string)).split('/')[0].rsplit('.', 1)[0] }}.{{ node_o }}
{%           endif %}
{%         endfor %}
{%       endif %}
{%     endfor %}
      interfaces:
{%     for b in nic_layout %}
{%       set bidx = loop.index0 %}
{%       set has = (b.roles is not defined) or ('worker' in (b.roles | default([]))) %}
{%       if has %}
{%         set attach = b.network | default(b.trunk) %}
{%         for k in range(b.nics) %}
        - devname: eth{{ ns.i }}
          bond: {{ b.bond }}
          attach: {{ c.name }}-{{ attach }}
          mac: "{{ mac_oui }}:{{ '%02x' | format(ci) }}:{{ '%02x' | format(bidx * 16 + k) }}:{{ '%02x' | format(node_o) }}"
{%         if networks[attach].mtu is defined %}
          mtu: {{ networks[attach].mtu }}
{%         endif %}
{%         set ns.i = ns.i + 1 %}
{%         endfor %}
{%       endif %}
{%     endfor %}
      disks:
{%     for d in (worker_disks | default(c.disks | default(default_disks))) %}
        - { suffix: {{ d.suffix }}, capacity_gib: {{ d.capacity_gib }}, target: {{ d.target }} }
{%     endfor %}
{%   endfor %}
{% endfor %}
