#!/usr/bin/env bash
# libvirt qemu hook: put each lab VM under a memory.high cap so its coldest pages
# get pushed into the host's zram (compressed-RAM swap) early, instead of pinning
# all of the VM's RAM. The host OS and other processes are left untouched.
#
# Install to /etc/libvirt/hooks/qemu (scripts/optimize-host.sh does this). libvirt
# calls it as:  qemu <guest> <op> <sub-op> <extra>  with the domain XML on stdin.
#
# On 'started' for our guests it finds the VM's transient systemd scope
# (machine-qemu-*-<guest>.scope, cgroup v2) and sets memory.high to PCT% of the
# VM's RAM. Reclaimed anon pages go to zram (the system swap), where they are
# compressed. Tunable: VMETAL_MEM_HIGH_PCT (env, default 60; 0 = skip).
set -u

guest="${1:-}"
op="${2:-}"
case "$guest" in
  *-node[0-9]*|*-day2-worker[0-9]*) : ;;
  *) exit 0 ;;
esac
[[ "$op" == "started" || "$op" == "reconnect" ]] || exit 0

xml="$(cat)"
mem_kib="$(printf '%s' "$xml" | grep -oP "(?<=<memory unit='KiB'>)[0-9]+" | head -1)"
[[ -n "$mem_kib" ]] || exit 0
pct="${VMETAL_MEM_HIGH_PCT:-60}"
[[ "$pct" -gt 0 ]] || exit 0
high=$(( mem_kib * 1024 * pct / 100 ))

shopt -s nullglob
for s in /sys/fs/cgroup/machine.slice/*qemu*.scope; do
  # scope names escape '-' as '\x2d'; decode and match the exact guest.
  name="$(basename "$s" | sed 's/\\x2d/-/g')"
  [[ "$name" == *"-${guest}.scope" ]] || continue
  [[ -f "$s/memory.high" ]] && echo "$high" > "$s/memory.high" 2>/dev/null || true
done
exit 0
