#!/usr/bin/env bash
# libvirt qemu hook: put each lab VM in a "compressed RAM" regime.
#
# Install to /etc/libvirt/hooks/qemu (scripts/optimize-host.sh does this). libvirt
# calls it as:  qemu <guest> <op> <sub-op> <extra>  with the domain XML on stdin.
#
# On 'started' for our guests it locates the transient systemd scope libvirt made
# for the VM (machine-qemu-*-<guest>.scope, cgroup v2) and:
#   * memory.zswap.max = max     -> evicted pages go to the compressed zswap pool
#   * memory.high      = PCT% of the VM's RAM (default 60) -> the cgroup starts
#     reclaiming the VM's coldest pages early (into zswap) instead of pinning all
#     of its RAM. The host OS and other processes are untouched.
#
# Only the lab's own VMs are touched; everything else on the host is left alone.
# Tunable: VMETAL_MEM_HIGH_PCT (env, default 60). Set 0 to skip the memory.high
# squeeze and only enable per-VM zswap.
set -u

guest="${1:-}"
op="${2:-}"

case "$guest" in
  *-node[0-9]*|*-day2-worker[0-9]*) : ;;   # lab nodes only
  *) exit 0 ;;
esac
[[ "$op" == "started" || "$op" == "reconnect" ]] || exit 0

xml="$(cat)"   # full domain XML on stdin
mem_kib="$(printf '%s' "$xml" | grep -oP "(?<=<memory unit='KiB'>)[0-9]+" | head -1)"
[[ -n "$mem_kib" ]] || exit 0

pct="${VMETAL_MEM_HIGH_PCT:-60}"

# The scope name escapes '-' as '\x2d'; glob across the machine slice.
shopt -s nullglob
for scope in /sys/fs/cgroup/machine.slice/machine-qemu*"${guest//-/\\x2d}".scope; do
  [[ -d "$scope" ]] || continue
  [[ -f "$scope/memory.zswap.max" ]] && echo max > "$scope/memory.zswap.max" 2>/dev/null || true
  if [[ "$pct" -gt 0 && -f "$scope/memory.high" ]]; then
    high=$(( mem_kib * 1024 * pct / 100 ))
    echo "$high" > "$scope/memory.high" 2>/dev/null || true
  fi
done
exit 0
